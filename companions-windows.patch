diff --git a/native/modules/CMakeLists.txt b/native/modules/CMakeLists.txt
index e782dc9..53e4e54 100644
--- a/native/modules/CMakeLists.txt
+++ b/native/modules/CMakeLists.txt
@@ -2,7 +2,7 @@
 # SPDX-License-Identifier: GPL-3.0-or-later
 
 cmake_minimum_required(VERSION 3.22)
-project(eden-dsmod-native-modules LANGUAGES CXX)
+project(eden-dsmod-native-modules LANGUAGES C CXX)
 
 if(ANDROID AND NOT ANDROID_STL STREQUAL "c++_static")
     message(FATAL_ERROR "Native DSMod modules must use -DANDROID_STL=c++_static")
@@ -64,7 +64,17 @@ function(dsmod_add_module target)
         "${EDEN_SOURCE_ROOT}/src/core/mods/modules/dsmod_module_sdk.h"
         "${EDEN_SOURCE_ROOT}/src/core/mods/dsmod_module_abi.h"
         "${EDEN_SOURCE_ROOT}/src/core/mods/dsmod_module_extensions.h")
+    # Remember the target so the MSVC block at the end of this file can normalise its options.
+    set_property(GLOBAL APPEND PROPERTY DSMOD_MODULE_TARGETS ${target})
     target_compile_features(${target} PRIVATE cxx_std_20)
+    if(MSVC)
+        # fmt 12 static_asserts on MSVC without /utf-8 (source and execution charset UTF-8); the
+        # biggest translation units (dread, p5r) also exceed the default object section limit.
+        # _USE_MATH_DEFINES gives M_PI to the image code; NOMINMAX keeps windows.h from defining
+        # min/max macros over the STL calls.
+        target_compile_options(${target} PRIVATE /utf-8 /bigobj)
+        target_compile_definitions(${target} PRIVATE _USE_MATH_DEFINES NOMINMAX)
+    endif()
     target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_LIST_DIR}" "${EDEN_SOURCE_ROOT}/src"
         ${ARG_INCLUDE_DIRECTORIES})
     if(ARG_COMPILE_DEFINITIONS)
@@ -87,6 +97,13 @@ function(dsmod_add_module target)
             "-Wl,--no-undefined"
             "-Wl,--version-script=${script_file}")
         set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${script_file}")
+    elseif(MSVC)
+        # Windows DLL: the SDK getters are plain extern "C" (the header cannot mark them
+        # __declspec(dllexport) without clashing with dsmod_module_abi.h), so name every export
+        # explicitly. x64 C symbols are undecorated, which is what the host looks up.
+        foreach(symbol IN LISTS ARG_EXPORTS)
+            target_link_options(${target} PRIVATE "/EXPORT:${symbol}")
+        endforeach()
     endif()
     if(ANDROID)
         target_link_options(${target} PRIVATE "-Wl,--exclude-libs,ALL")
@@ -997,3 +1014,61 @@ if(BUILD_TESTING AND NOT ANDROID)
   add_executable(dsmod-echoes-quick-slot-bridge-test echoes_quick_slot_bridge_test.cpp)
   add_test(NAME dsmod-echoes-quick-slot-bridge COMMAND dsmod-echoes-quick-slot-bridge-test)
 endif()
+
+# Castlevania: Belmont's Curse (title 0100BA4026E94000). Upstream builds this one outside CMake
+# (see belmont_build.sh); it is declared here so every platform shares one target and the Windows
+# DLL exports the same getters. Its romfs reader decompresses with lz4, taken from Eden's cache.
+file(GLOB BELMONT_LZ4_SOURCES LIST_DIRECTORIES false "${EDEN_CPM_CACHE}/lz4/*/lib/lz4.c")
+list(LENGTH BELMONT_LZ4_SOURCES belmont_lz4_count)
+if(NOT belmont_lz4_count EQUAL 1)
+    message(FATAL_ERROR "Expected one lz4 source in ${EDEN_CPM_CACHE}/lz4; configure the compatible Eden Duo checkout first")
+endif()
+list(GET BELMONT_LZ4_SOURCES 0 BELMONT_LZ4_SOURCE)
+get_filename_component(BELMONT_LZ4_DIR "${BELMONT_LZ4_SOURCE}" DIRECTORY)
+dsmod_add_module(dsmod-belmont EXCLUDE_FROM_ALL TITLE 0100BA4026E94000
+    SOURCES 0100BA4026E94000.cpp belmont_assets.cpp belmont_map_assets.cpp belmont_map_tiles.cpp
+        belmont_map_fog.cpp belmont_map_render.cpp belmont_world_map.cpp belmont_map_labels.cpp
+        belmont_map_landmarks.cpp belmont_equipment_assets.cpp belmont_landmark_render.cpp
+        belmont_objective_labels.cpp chained_echoes_unity.cpp
+        "${EDEN_SOURCE_ROOT}/externals/bc_decoder/bc_decoder.cpp"
+        "${BELMONT_LZ4_SOURCE}"
+    INCLUDE_DIRECTORIES "${EDEN_SOURCE_ROOT}/externals/bc_decoder" "${BELMONT_LZ4_DIR}"
+    EXPORTS eden_dsmod_get_module eden_dsmod_get_extensions
+        eden_dsmod_get_font_extensions eden_dsmod_get_data_extensions)
+set_source_files_properties("${EDEN_SOURCE_ROOT}/externals/bc_decoder/bc_decoder.cpp"
+    PROPERTIES COMPILE_OPTIONS -w) # upstream file
+
+# ---- MSVC: drop GCC/Clang-only compile options -----------------------------------------------
+# The module sources are written for GCC/Clang (Linux, Android, macOS): -ffp-contract, -fno-*,
+# -ffile-prefix-map, -Wall/-Wextra/-Werror/-w and -O2 are rejected or meaningless under cl.exe.
+# Remove every option that starts with '-' from the module targets and from the sources whose
+# options were set individually (dread_mapgen, mk8d_assets, echoes_fonts, DQ3's ooz files, the
+# bc_decoder copy). Warnings stay at the Eden Duo MSVC defaults (/W3 /WX-).
+if(MSVC)
+    get_property(msvc_targets GLOBAL PROPERTY DSMOD_MODULE_TARGETS)
+    foreach(target IN LISTS msvc_targets)
+        get_target_property(target_options ${target} COMPILE_OPTIONS)
+        if(target_options)
+            set(keep)
+            foreach(option IN LISTS target_options)
+                if(NOT option MATCHES "^-")
+                    list(APPEND keep "${option}")
+                endif()
+            endforeach()
+            set_target_properties(${target} PROPERTIES COMPILE_OPTIONS "${keep}")
+        endif()
+        get_target_property(target_sources ${target} SOURCES)
+        foreach(source IN LISTS target_sources)
+            get_source_file_property(source_options "${source}" COMPILE_OPTIONS)
+            if(source_options)
+                set(keep)
+                foreach(option IN LISTS source_options)
+                    if(NOT option MATCHES "^-")
+                        list(APPEND keep "${option}")
+                    endif()
+                endforeach()
+                set_source_files_properties("${source}" PROPERTIES COMPILE_OPTIONS "${keep}")
+            endif()
+        endforeach()
+    endforeach()
+endif()
\ No newline at end of file
